---
const cases = [
	{
		label: 'Birthdays',
		user: "Don't let me forget Dad's birthday again",
		alfy: "It's the 14th. I'll remind you a week out, with three gift ideas. — A",
	},
	{
		label: 'Appointments',
		user: 'I need a haircut before the wedding',
		alfy: 'Your barber has Thursday 5:30 free. Want it? — A',
	},
	{
		label: 'Bills',
		user: 'Is the electric bill normal this month?',
		alfy: "It's $12 higher than usual. Want me to ask them why? — A",
	},
	{
		label: 'Plans',
		user: 'Dinner with Sam next week, somewhere quiet',
		alfy: 'Tuesday works for you both. Three quiet places near Sam, none booked yet. — A',
	},
	{
		label: 'Email',
		user: 'Did I ever reply to the school?',
		alfy: "Not yet. I've drafted a reply — want to see it before it goes? — A",
	},
	{
		label: 'Travel',
		user: 'Find me a cheap flight home for Christmas',
		alfy: 'Two options under $90, both nonstop. Neither books without your yes. — A',
	},
];
---

<section class="use-cases mx-auto max-w-6xl px-6 py-20 lg:py-28" id="handles">
	<div class="uc-drift max-w-lg space-y-3">
		<h2 class="uc-fade font-display text-h1 font-semibold text-balance">
			The stuff you keep meaning to do.
		</h2>
		<p class="uc-fade text-body text-secondary">
			Text it to Alfy the moment you think of it, then forget about it. Alfy won't.
		</p>
	</div>

	<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{
			cases.map((c) => (
				<div class="uc-par">
					<article class="uc-card card-lift h-full rounded-3xl border border-hairline bg-card p-5 shadow-[0_8px_30px_-12px_rgba(46,42,36,0.12)] space-y-4">
						<p class="label-caps text-muted">{c.label}</p>
					<div class="flex justify-end">
						<p class="max-w-[90%] rounded-2xl rounded-br-sm bg-espresso px-4 py-2 text-body text-linen">
							{c.user}
						</p>
					</div>
						<div class="flex justify-start">
							<p class="max-w-[90%] rounded-2xl rounded-bl-sm border border-hairline bg-linen px-4 py-2 text-body text-espresso">
								{c.alfy}
							</p>
						</div>
					</article>
				</div>
			))
		}
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { reveal, drift } from '../lib/reveal';

	gsap.registerPlugin(ScrollTrigger);

	reveal('.uc-fade', '.use-cases', { stagger: 0.1 });
	drift('.uc-drift');

	// Scrubbed parallax on the wrapper (not the card itself, so the CSS hover
	// lift keeps working): columns rise from different depths as you scroll.
	const mm = gsap.matchMedia();
	mm.add('(prefers-reduced-motion: no-preference)', () => {
		gsap.utils.toArray<HTMLElement>('.uc-par').forEach((wrap, i) => {
			gsap.fromTo(
				wrap,
				{ y: 48 + (i % 3) * 32, opacity: 0.2 },
				{
					y: 0,
					opacity: 1,
					ease: 'none',
					scrollTrigger: { trigger: wrap, start: 'top 98%', end: 'top 55%', scrub: 0.4 },
				}
			);
		});
	});
</script>
