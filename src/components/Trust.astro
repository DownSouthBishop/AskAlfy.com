---
const ledger = [
	{ what: 'Replied to Dana about Thursday', when: 'you approved, 9:14am' },
	{ what: 'Booked the dentist for Tuesday 9:00', when: 'you approved, 8:02am' },
	{ what: 'Paid the wifi bill', when: 'a standing yes you gave 12 Jan' },
	{ what: 'Moved lunch with Priya to Friday', when: 'you approved, yesterday' },
];
---

<section class="trust border-y border-hairline bg-fern-tint/40" id="trust">
	<div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
		<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="trust-drift space-y-5">
				<h2 class="trust-fade font-display text-h1 font-semibold text-balance">
					Nothing leaves without a yes.
				</h2>
				<p class="trust-fade max-w-md text-body text-secondary">
					Every email, booking, and payment waits for your OK. When you're
					happy with how Alfy handles something, you can say "just do it from
					now on" — and take that back any time, by text.
				</p>
				<p class="trust-fade max-w-md text-body text-secondary">
					And everything Alfy does is written down in plain words, so you can
					see exactly what happened and undo what can be undone.
				</p>
				<a
					href="/app"
					class="trust-fade inline-block cursor-pointer text-body font-medium text-fern underline decoration-fern/40 underline-offset-4 transition-colors hover:text-espresso focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fern"
				>
					See what a week with Alfy looks like →
				</a>
			</div>

			<div
				class="trust-fade card-lift rounded-3xl border border-hairline bg-card p-6 shadow-[0_8px_30px_-12px_rgba(46,42,36,0.15)]"
			>
				<p class="label-caps text-muted">Handled</p>
				<ul class="mt-4 divide-y divide-hairline">
					{
						ledger.map((row) => (
							<li class="t-row flex items-start gap-3 py-3.5">
								<span
									class="t-check mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-fern-tint text-fern"
									aria-hidden="true"
								>
									<svg class="h-3 w-3" viewBox="0 0 16 16" fill="none">
										<path
											d="M3 8.5 6.5 12 13 4.5"
											stroke="currentColor"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
								<div>
									<p class="text-body text-espresso">{row.what}</p>
									<p class="text-small text-muted">{row.when}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { reveal, drift } from '../lib/reveal';

	gsap.registerPlugin(ScrollTrigger);

	reveal('.trust-fade', '.trust', { start: 'top 70%', stagger: 0.12 });
	drift('.trust-drift');

	// The ledger prints: each row slides in and its check pops as you scroll.
	const mm = gsap.matchMedia();
	mm.add('(prefers-reduced-motion: no-preference)', () => {
		gsap.utils.toArray<HTMLElement>('.t-row').forEach((row) => {
			const tl = gsap.timeline({
				scrollTrigger: { trigger: row, start: 'top 95%', end: 'top 72%', scrub: 0.4 },
			});
			tl.fromTo(row, { opacity: 0, x: -14 }, { opacity: 1, x: 0, ease: 'none' }).fromTo(
				row.querySelector('.t-check'),
				{ scale: 0 },
				{ scale: 1, ease: 'back.out(2.5)' },
				'<0.3'
			);
		});
	});
</script>
