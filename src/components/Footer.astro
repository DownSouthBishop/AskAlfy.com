---
import { SMS_URI } from '../lib/config';

const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
	<div class="mx-auto max-w-6xl px-6 py-16 text-center space-y-5">
		<p class="font-display text-h1 font-semibold text-balance">
			Ready when you are.
		</p>
		<a
			href={SMS_URI}
			class="inline-block cursor-pointer rounded-full bg-marigold px-6 py-3 text-body font-medium text-on-marigold transition-colors hover:bg-[#C97923] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-espresso"
		>
			Text Alfy
		</a>
		<p class="text-small text-secondary">© {year} Alfy</p>
	</div>
</footer>
