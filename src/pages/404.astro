---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alfy — page not found">
	<main class="mx-auto flex min-h-dvh max-w-6xl flex-col items-center justify-center gap-5 px-6 text-center">
		<h1 class="font-display text-h1 font-semibold">That page isn't here.</h1>
		<p class="max-w-sm text-body text-secondary">
			Nothing lost — everything Alfy can do starts from the homepage anyway.
		</p>
		<a
			href="/"
			class="cursor-pointer rounded-full bg-marigold px-6 py-3 text-body font-medium text-on-marigold transition-colors hover:bg-[#C97923]"
		>
			Back home
		</a>
	</main>
</Layout>
